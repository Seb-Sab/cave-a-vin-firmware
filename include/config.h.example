#pragma once

// =====================================================================
//  Cave a vin - configuration utilisateur
//  TEMPLATE — copier en config.h et remplir les valeurs reelles
//  (config.h est dans .gitignore, ne pas le committer)
// =====================================================================

// ---- WiFi (laisser vide : l'utilisateur configure via le portail captif) ----
#define WIFI_SSID   ""
#define WIFI_PASS   ""

// ---- Supabase API ----
#define SUPABASE_URL       "${SUPABASE_URL}"
#define SUPABASE_ANON_KEY  "${SUPABASE_ANON_KEY}"
#define DEVICE_TOKEN_DEFAULT  ""  // a configurer via le portail

// ---- Dashboard Next.js (sync langue boitier -> table devices) ----
#define DASHBOARD_API_URL         "https://cave-a-vin-dashboard.vercel.app/api/device/set-lang"
#define DASHBOARD_API_URL_NOTIFY  "https://cave-a-vin-dashboard.vercel.app/api/device/set-notify"

// ---- Telegram (lien de connexion auto via webhook serveur) ----
#define TELEGRAM_BOT_USERNAME  "CleverCellarAlerts_bot"

// ---- Periodes et timings ----
#define ENV_PERIOD_MS       (10UL * 60UL * 1000UL)  // envoi T/H/P toutes les 10 min
#define EDIT_WINDOW_MS      (10000UL)               // fenetre boutons apres lecture
#define LONGPRESS_MS        (3000UL)                // seuil appui long
#define DEBOUNCE_MS         (30UL)                  // anti-rebond minimum
#define ENROLL_TIMEOUT_MS   (30000UL)               // sortie auto du mode enregistrement
#define DARK_TIMEOUT_MS        (30000UL)              // obscurite maintenue avant mise en veille (30s)
#define INACTIVITY_TIMEOUT_MS  (30UL * 60UL * 1000UL) // inactivite avant mise en veille (30 min)
#define ALARM_ACK_TIMEOUT_MS   (5UL  * 60UL * 1000UL) // delai max affichage alarme sans acquittement (5 min)
#define STARTUP_ENV_DELAY_MS   (60000UL)               // delai avant premiere verif conditions au cold start (1 min)

// ---- Broches ----
#define PIN_LED         2   // LED interne ESP32
#define PIN_MOSFET      25  // Gate AO3401 (LOW = peripheriques alimentes)
#define PIN_LDR         34  // ADC LDR (input only, RTC-capable pour wakeup)
#define PIN_LED_STRIP   26  // Data ruban LED
#define PIN_BTN_PLUS    32
#define PIN_BTN_MINUS   33
#define PIN_I2C_SDA     21
#define PIN_I2C_SCL     22

// ---- OLED (SH1106 1.3") ----
#define OLED_WIDTH   128
#define OLED_HEIGHT  64
#define OLED_ADDR    0x3C

// ---- PN532 (I2C) ----
#define PN532_I2C_ADDR  0x24

// ---- Ruban LED ----
#define LED_COUNT       15
#define LED_BTN_MINUS   11   // LED 12 -> BTN-
#define LED_BTN_PLUS    13   // LED 14 -> BTN+

// ---- LDR seuil veille ----
#define LDR_DARK_THRESHOLD  1000

// ---- Touch buttons (T9=GPIO32=BTN+, T8=GPIO33=BTN-) ----
#define TOUCH_THRESHOLD     50

// ---- Mesure quotidienne en deep sleep ----
#define ENV_DAILY_WAKEUP_US  (24ULL * 60ULL * 60ULL * 1000000ULL)
#define BME_WARMUP_MS        (5UL  * 60UL  * 1000UL)

// ---- Portail de configuration ----
#define PORTAL_AP_SSID  "Cave-a-vin"

// ---- OTA via GitHub Releases ----
#define FIRMWARE_VERSION   "${FIRMWARE_VERSION}"
#define GITHUB_REPO_OWNER  "${GITHUB_REPO_OWNER}"
#define GITHUB_REPO_NAME   "${GITHUB_REPO_NAME}"

// ---- Seuils alarme cave (valeurs par defaut, surcharges par NVS) ----
#define TEMP_MIN_DEFAULT  10.0f
#define TEMP_MAX_DEFAULT  14.0f
#define HUM_MIN_DEFAULT   60.0f
#define HUM_MAX_DEFAULT   80.0f
